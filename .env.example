# Variables d'environnement à configurer sur Railway

# Clé API 2captcha pour résoudre les CAPTCHAs
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# URL Webhook Base44 pour mettre à jour le ticket avec le code-barres
# Format: https://api.base44.com/apps/YOUR_APP_ID/entities/Ticket/YOUR_TICKET_ID/update
BASE44_WEBHOOK_URL=https://your-base44-app.base44.app/api/webhook

# Port (Railway le définit automatiquement)
PORT=8000
